# Copy to .env and adjust. .env is git-ignored.

# Used by docker-compose.yml
POSTGRES_USER=vidituka
POSTGRES_PASSWORD=vidituka
POSTGRES_DB=vidituka

# Used by the backend (see backend/src/vidituka/config.py)
VIDITUKA_DATABASE_URL=postgresql://vidituka:vidituka@localhost:5432/vidituka
VIDITUKA_HTTP_USER_AGENT=vidituka/0.1 (+https://github.com/CHANGE-ME/vidituka)
