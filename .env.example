# Copy to .env and adjust. .env is git-ignored.

# Used by docker-compose.yml
POSTGRES_USER=vidituka
POSTGRES_PASSWORD=vidituka
POSTGRES_DB=vidituka
POSTGRES_PORT=5433

# Used by the backend (see backend/src/vidituka/config.py)
VIDITUKA_DATABASE_URL=postgresql+psycopg://vidituka:vidituka@localhost:5433/vidituka
VIDITUKA_TEST_DATABASE_URL=postgresql+psycopg://vidituka:vidituka@localhost:5433/vidituka_test
VIDITUKA_HTTP_USER_AGENT=vidituka/0.1 (+https://github.com/nataliovcharov/vidituka)
